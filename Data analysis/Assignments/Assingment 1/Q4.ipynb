   "source": [
    "#### Find out the indices of non zero element in given array\n",
    "#### [1,2,0,0,4,0]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "5aaeb270-1405-41d3-8b3d-50769a7878a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "166e9130-a895-460f-82a3-b02fac0fee95",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([1, 2, 0, 0, 4, 0])"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr = np.array([1,2,0,0,4,0])\n",
    "arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "adcad127-0d3e-49dd-99a3-a70dc5ff9267",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[0 1 4]\n"
     ]
    }
   ],
   "source": [
    "\n",
    "indices = np.nonzero(arr)[0]\n",
    "print(indices)  \n"
   ]
